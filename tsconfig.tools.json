{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "@webgpu/types"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "knip.config.ts",
    "eslint.config.ts",
    "site/app/migration/sources.d.ts"
  ],
  "exclude": ["**/node_modules/**", ".engine"]
}
