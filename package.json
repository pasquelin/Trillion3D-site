{
  "name": "trillion3d-site",
  "version": "1.0.0",
  "description": "The Trillion3D website: the learning portal, the API reference, the reports and the examples, built against the pinned engine.",
  "homepage": "https://www.trillion3d.com",
  "bugs": "https://github.com/pasquelin/Trillion3D-site/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pasquelin/Trillion3D-site.git"
  },
  "packageManager": "pnpm@11.16.0",
  "type": "module",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "trillion3d": {
    "repository": "https://github.com/pasquelin/Trillion3D.git",
    "commit": "9eb8d185467608382226ce5f2c72786c5176d7e5"
  },
  "imports": {
    "#engine/*": "./.engine/*"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks && node scripts/engine.ts && node scripts/generate-api-reference.ts",
    "engine": "node scripts/engine.ts",
    "build:native": "node scripts/engine.ts --native",
    "compile:caches": "node scripts/site-caches.ts",
    "generate:api": "node scripts/generate-api-reference.ts",
    "build:docs": "node scripts/docs/build.ts",
    "docs:gallery": "node scripts/docs/gallery.ts",
    "docs:serve": "node scripts/docs/serve.ts",
    "docs:dev": "node scripts/docs/dev.ts",
    "test:docs": "node scripts/docs/tests.ts",
    "lint": "eslint .",
    "format": "prettier --ignore-path .gitignore --ignore-path .prettierignore --write \"**/*.{ts,mts,tsx,json}\"",
    "format:check": "prettier --ignore-path .gitignore --ignore-path .prettierignore --check \"**/*.{ts,mts,tsx,json}\"",
    "knip": "knip",
    "check:site-types": "tsc -p tsconfig.site.json --noEmit",
    "check:tools-types": "tsc -p tsconfig.tools.json --noEmit",
    "check:docs-bundles": "node scripts/docs/build.ts --untracked",
    "check:links": "node scripts/check-links.ts",
    "check:docs-three": "node scripts/check-docs-three.ts",
    "check:i18n": "node scripts/check-i18n.ts",
    "check:translations": "node scripts/check-translations.ts",
    "check:english": "node scripts/check-english.ts",
    "check:thumbnails": "node scripts/check-thumbnails.ts",
    "validate": "pnpm run format:check && pnpm run lint && pnpm run knip && pnpm run check:site-types && pnpm run check:tools-types && pnpm run check:links && pnpm run check:docs-three && pnpm run check:i18n && pnpm run check:translations && pnpm run check:english && pnpm run check:thumbnails && pnpm run check:docs-bundles && pnpm run test:docs && pnpm run build:docs"
  },
  "devDependencies": {
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/language": "^6.12.4",
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.2.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@webgpu/types": "^0.1.72",
    "codemirror": "^6.0.2",
    "daisyui": "^5.7.42",
    "esbuild": "^0.25.12",
    "eslint": "^10.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "flag-icons": "^7.5.0",
    "globals": "^17.12.0",
    "highlight.js": "^11.12.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "knip": "^6.35.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "tailwindcss": "^4.3.3",
    "three": "^0.174.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
